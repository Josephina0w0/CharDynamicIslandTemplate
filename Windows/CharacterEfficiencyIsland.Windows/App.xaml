<Application x:Class="CharacterEfficiencyIsland.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#F7F7F8" />
    <SolidColorBrush x:Key="PrimaryText" Color="#222222" />
    <SolidColorBrush x:Key="SecondaryText" Color="#767676" />
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,3,8,3" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="29" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Resources>
</Application>
