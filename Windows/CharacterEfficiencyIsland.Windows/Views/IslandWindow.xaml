<Window x:Class="CharacterEfficiencyIsland.Windows.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <Grid>
    <Border x:Name="IslandBody"
            CornerRadius="38"
            Background="#E81F1F21"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="IslandBody_OnMouseLeftButtonDown"
            MouseEnter="IslandBody_OnMouseEnter"
            MouseLeave="IslandBody_OnMouseLeave">
      <Grid>
        <Grid x:Name="HorizontalLayout" Margin="16,9,18,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="138" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image x:Name="HorizontalImage" Grid.Column="0" Stretch="Uniform" Margin="0,-8,8,-8" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="HorizontalTitle" Foreground="White" FontSize="25" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="HorizontalTimer" Foreground="White" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Margin="0,4,0,0" />
            <TextBlock x:Name="HorizontalDetail" Foreground="#E6FFFFFF" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="42" />
          </StackPanel>
        </Grid>

        <Grid x:Name="VerticalLayout" Visibility="Collapsed" Margin="10,14,10,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock x:Name="VerticalTitle" Foreground="White" FontSize="19" FontWeight="Bold" TextAlignment="Center" LineHeight="21" />
            <TextBlock x:Name="VerticalDetail" Foreground="#E6FFFFFF" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Width="118" Margin="0,9,0,0" />
          </StackPanel>
          <TextBlock x:Name="VerticalTimer" Grid.Row="1" Foreground="White" FontSize="21" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5" />
          <Image x:Name="VerticalImage" Grid.Row="2" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <primitives:Thumb x:Name="ResizeThumb"
                      Width="22"
                      Height="22"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Cursor="SizeNWSE"
                      Opacity="0.01"
                      DragStarted="ResizeThumb_OnDragStarted"
                      DragDelta="ResizeThumb_OnDragDelta"
                      DragCompleted="ResizeThumb_OnDragCompleted" />
  </Grid>
</Window>
