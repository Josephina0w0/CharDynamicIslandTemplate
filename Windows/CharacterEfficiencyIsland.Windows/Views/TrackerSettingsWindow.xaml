<Window x:Class="CharacterEfficiencyIsland.Windows.Views.TrackerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tracker 设置" Width="440" Height="470" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" Background="#FFF0F0F0" ShowInTaskbar="False">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="54" />
      <RowDefinition Height="66" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>
    <TextBlock Text="Tracker 设置" FontSize="23" FontWeight="Bold" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
      <TextBlock Text="显示这些 Windows 日历（只读）" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="SelectionStatus" Grid.Column="1" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="2" BorderBrush="#24000000" BorderThickness="1" CornerRadius="8" Background="#7AFFFFFF" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="CalendarList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Checked="CalendarSelection_OnChanged" Unchecked="CalendarSelection_OnChanged" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="3" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <Button Content="全选" Click="SelectAll_OnClick" />
        <Button Content="全不选" Click="SelectNone_OnClick" />
      </StackPanel>
      <Button Content="授权 / 刷新日历" HorizontalAlignment="Right" Click="Refresh_OnClick" />
    </Grid>
    <TextBlock x:Name="Explanation" Grid.Row="4" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="11.5"
               Text="Tracker 只申请 Windows 日历的只读权限，不会创建、修改或删除日历事项。日历选择、自定义标题、Daily Top 3 和项目状态仅保存在本机。" />
    <Button Grid.Row="5" Content="完成" Width="90" HorizontalAlignment="Right" Click="Done_OnClick" />
  </Grid>
</Window>
