<Window x:Class="CharacterEfficiencyIsland.Windows.Views.TrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Tracker" Width="420" Height="632"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI"
        KeyDown="Window_OnKeyDown">
  <Canvas x:Name="RootCanvas" Width="420" Height="632" Background="Transparent"
          MouseLeftButtonDown="Root_OnMouseLeftButtonDown">
    <Border Canvas.Left="0" Canvas.Top="16" Width="420" Height="568"
            CornerRadius="20" Background="{StaticResource PanelBackground}"
            BorderBrush="#22000000" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#55000000" BlurRadius="20" ShadowDepth="5" Opacity="0.45" />
      </Border.Effect>
    </Border>

    <TextBox x:Name="TitleEditor" Canvas.Left="24" Canvas.Top="27" Width="230" Height="25"
             Text="日常 Tracker" FontSize="19" FontWeight="ExtraBold" Padding="0" Margin="0"
             Background="Transparent" BorderThickness="0" LostKeyboardFocus="TitleEditor_OnLostKeyboardFocus" />
    <TextBlock Canvas.Left="260" Canvas.Top="33" Width="136" Height="14"
               Text="标题与任务可直接点击编辑" TextAlignment="Right"
               Foreground="#9A7A7A7A" FontSize="9.5" />
    <TextBlock Canvas.Left="24" Canvas.Top="55" Width="286" Height="16"
               Text="日程、任务与 Windows 日历" Foreground="{StaticResource SecondaryText}"
               FontSize="11.5" FontWeight="Medium" />

    <TextBlock x:Name="MonthLabel" Canvas.Left="24" Canvas.Top="78" Width="140" Height="20"
               FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
    <Button Canvas.Left="164" Canvas.Top="77" Width="24" Height="24" Content="‹" Padding="0" Margin="0"
            MinHeight="0" Click="PreviousMonth_OnClick" />
    <Button Canvas.Left="190" Canvas.Top="77" Width="24" Height="24" Content="›" Padding="0" Margin="0"
            MinHeight="0" Click="NextMonth_OnClick" />

    <primitives:UniformGrid x:Name="CalendarGrid" Canvas.Left="24" Canvas.Top="110" Width="172" Height="150"
                            Rows="7" Columns="7" />
    <TextBlock x:Name="CalendarStatus" Canvas.Left="24" Canvas.Top="266" Width="190" Height="15"
               FontSize="9.5" FontWeight="Medium" Foreground="#A06F6F6F" TextTrimming="CharacterEllipsis" />

    <Border Canvas.Left="220" Canvas.Top="110" Width="176" Height="150"
            Background="#0A000000" BorderBrush="#24000000" BorderThickness="1" CornerRadius="13">
      <Grid Margin="12,8,12,9">
        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="Daily Top 3" FontSize="12.5" FontWeight="Bold" />
        <ItemsControl x:Name="TaskList" Grid.Row="1">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Height="37">
                <Grid.ColumnDefinitions><ColumnDefinition Width="21" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="0" VerticalAlignment="Center"
                          Checked="Task_OnChanged" Unchecked="Task_OnChanged" />
                <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         TextWrapping="Wrap" FontSize="10" FontWeight="SemiBold" MinHeight="0" Height="35"
                         Padding="0" Margin="0" Background="Transparent" BorderThickness="0"
                         LostKeyboardFocus="Task_OnChanged" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Canvas.Left="24" Canvas.Top="288" Width="372" Height="68"
            Background="#08000000" BorderBrush="#24000000" BorderThickness="1" CornerRadius="13">
      <Grid Margin="12,8,12,5">
        <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock x:Name="SelectedDateTitle" FontSize="12.5" FontWeight="Bold" />
        <ItemsControl x:Name="SelectedDateItems" Grid.Row="1" FontSize="10">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Height="18" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Canvas.Left="24" Canvas.Top="378" Width="372" Height="150"
            Background="#08000000" BorderBrush="#24000000" BorderThickness="1" CornerRadius="13">
      <Grid Margin="12,8,12,9">
        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="近期关键日期" FontSize="12.5" FontWeight="Bold" />
        <ItemsControl x:Name="UpcomingItems" Grid.Row="1" FontSize="10.5">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Height="21" MaxWidth="252" HorizontalAlignment="Left" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <TextBlock Canvas.Left="24" Canvas.Top="531" Width="270" Height="14"
               Text="计划与完成状态仅自动保存在本机" FontSize="9.5" Foreground="#987A7A7A" />
    <StackPanel Canvas.Left="24" Canvas.Top="547" Height="22" Orientation="Horizontal">
      <Button Content="恢复默认位置" Width="100" Height="22" MinHeight="0" Padding="4,0" Margin="0,0,8,0" FontSize="10.5" Click="ResetPosition_OnClick" />
      <Button Content="打开记录" Width="82" Height="22" MinHeight="0" Padding="4,0" Margin="0,0,8,0" FontSize="10.5" Click="OpenRecords_OnClick" />
      <Button Content="设置" Width="62" Height="22" MinHeight="0" Padding="4,0" Margin="0,0,8,0" FontSize="10.5" Click="Settings_OnClick" />
      <Button Content="项目进度" Width="82" Height="22" MinHeight="0" Padding="4,0" Margin="0" FontSize="10.5" Click="Projects_OnClick" />
    </StackPanel>

    <Image x:Name="TrackerCharacter" Canvas.Left="339" Canvas.Top="456" Width="104" Height="149"
           Stretch="Uniform" VerticalAlignment="Bottom" IsHitTestVisible="False" />
  </Canvas>
</Window>
