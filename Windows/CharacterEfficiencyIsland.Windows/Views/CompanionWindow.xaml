<Window x:Class="CharacterEfficiencyIsland.Windows.Views.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <Grid MouseLeftButtonDown="Root_OnMouseLeftButtonDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="41.4" />
    </Grid.RowDefinitions>

    <Grid x:Name="CharacterResizeSurface"
          Grid.Row="0"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Margin="0">
      <Image x:Name="CharacterImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
      <primitives:Thumb Tag="Left" Width="18" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0.01" DragStarted="ResizeThumb_OnDragStarted" DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted" />
      <primitives:Thumb Tag="Right" Width="18" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0.01" DragStarted="ResizeThumb_OnDragStarted" DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted" />
      <primitives:Thumb Tag="Top" Height="18" VerticalAlignment="Top" Cursor="SizeNS" Opacity="0.01" DragStarted="ResizeThumb_OnDragStarted" DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted" />
      <primitives:Thumb Tag="Bottom" Height="18" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0.01" DragStarted="ResizeThumb_OnDragStarted" DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted" />
    </Grid>

    <Border Grid.Row="1"
            Width="219.6"
            Height="30.6"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="#CC8E8E8E"
            CornerRadius="15.3">
      <TextBlock x:Name="MetricsLabel"
                 Margin="9,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 FontSize="11.7"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
    </Border>

  </Grid>
</Window>
