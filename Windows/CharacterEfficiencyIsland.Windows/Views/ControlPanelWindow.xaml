<Window x:Class="CharacterEfficiencyIsland.Windows.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="520" Height="500" FontFamily="Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True">
  <Grid>
    <Viewbox Stretch="Uniform" StretchDirection="Both">
      <Border x:Name="PanelBody" Width="520" Height="500"
              Background="{StaticResource PanelBackground}"
              BorderBrush="Transparent" BorderThickness="0" CornerRadius="24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="315" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Margin="18,14,7,10" ClipToBounds="True">
            <StackPanel VerticalAlignment="Top">
              <TextBlock x:Name="ModeTitle" Visibility="Collapsed" />
              <TextBlock x:Name="ModeSubtitle" Visibility="Collapsed" />
              <Border Height="1" Background="#18000000" Margin="0,2,0,7" />
              <WrapPanel Margin="0,0,0,4">
                <TextBlock x:Name="WorkLabel" FontSize="14" FontWeight="Bold" Margin="0,0,11,0" />
                <TextBlock x:Name="BreakLabel" FontSize="14" FontWeight="Bold" Margin="0,0,11,0" />
                <TextBlock x:Name="AiLabel" FontSize="14" FontWeight="Bold" />
              </WrapPanel>
              <WrapPanel>
                <TextBlock x:Name="IdleLabel" Foreground="{StaticResource SecondaryText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="喝水打卡" Click="Water_OnClick" />
              </WrapPanel>
              <TextBlock x:Name="TodayLabel" Foreground="#999999" FontSize="10.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              <TextBlock x:Name="TotalLabel" Foreground="#A6A6A6" FontSize="10.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,6" />
              <Border Height="1" Background="#18000000" Margin="0,0,0,7" />
              <TextBlock Text="定时提醒" FontSize="13.5" FontWeight="Bold" />
              <StackPanel x:Name="ReminderRows" Margin="0,3,0,5" />
              <Border Height="1" Background="#18000000" Margin="0,0,0,7" />
              <CheckBox x:Name="AiReminderCheck" Content="Codex 完成提醒" Checked="OptionCheck_OnChanged" Unchecked="OptionCheck_OnChanged" />
              <CheckBox x:Name="SurfaceCheck" Content="显示常驻角色" Checked="OptionCheck_OnChanged" Unchecked="OptionCheck_OnChanged" />
              <CheckBox x:Name="StartupCheck" Content="登录 Windows 时启动" Checked="StartupCheck_OnChanged" Unchecked="StartupCheck_OnChanged" />
              <TextBlock x:Name="CodexStatusLabel" Foreground="{StaticResource SecondaryText}" FontSize="10.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,3" />
              <WrapPanel Margin="0,1,0,3">
                <TextBlock x:Name="ScaleLabel" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,7,0" />
                <Button Content="重置人物大小" FontSize="10" Padding="5,3" Margin="0,2,3,2" Click="ResetScale_OnClick" />
                <Button Content="重置面板大小" FontSize="10" Padding="5,3" Margin="0,2,0,2" Click="ResetPanelScale_OnClick" />
              </WrapPanel>
              <WrapPanel>
                <Button Content="休息 5 分钟" Click="StartBreak_OnClick" />
                <Button Content="结束休息" Click="EndBreak_OnClick" />
                <Button Content="暂停／继续" Click="TogglePause_OnClick" />
              </WrapPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="清零今日" FontSize="10" Padding="3,3" Margin="0,2,3,2" Click="ResetToday_OnClick" />
                <Button Grid.Column="1" Content="清空全部" FontSize="10" Padding="3,3" Margin="0,2,3,2" Click="ResetAll_OnClick" />
                <Button Grid.Column="2" Content="打开记录" FontSize="10" Padding="3,3" Margin="0,2,3,2" Click="OpenRecords_OnClick" />
                <Button Grid.Column="3" x:Name="TrackerButton" Content="Tracker" FontSize="10" Padding="3,3" Margin="0,2,3,2" Click="Tracker_OnClick" />
                <Button Grid.Column="4" Content="退出" FontSize="10" Padding="3,3" Margin="0,2,0,2" Click="Quit_OnClick" />
              </Grid>
            </StackPanel>
          </Grid>

          <Grid x:Name="ArtContainer" Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.RowSpan="2" Width="1" Background="#10000000" HorizontalAlignment="Left" Margin="0,6,0,12" />
            <Image x:Name="PanelImage" Grid.RowSpan="2" Stretch="Uniform"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   IsHitTestVisible="False" Panel.ZIndex="0" />
            <StackPanel Grid.Row="0" Margin="14,18,8,6" Panel.ZIndex="1">
              <TextBlock Text="输入仪表" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5" />
              <TextBlock x:Name="TypingLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
              <TextBlock x:Name="RawSpeedLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
              <TextBlock x:Name="CorrectionLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
              <TextBlock x:Name="AverageSpeedLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
              <TextBlock x:Name="ApmLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
              <TextBlock x:Name="EpmLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
              <TextBlock x:Name="InputStatusLabel" Foreground="{StaticResource SecondaryText}" FontSize="9.5" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Viewbox>

    <primitives:Thumb Tag="Left" Width="8" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="Right" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="Top" Height="8" VerticalAlignment="Top" Cursor="SizeNS" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="Bottom" Height="8" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="TopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="TopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="BottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
    <primitives:Thumb Tag="BottomRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0.01" DragDelta="PanelResize_OnDragDelta" DragCompleted="PanelResize_OnDragCompleted" />
  </Grid>
</Window>
