<Window x:Class="CharacterEfficiencyIsland.Windows.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780"
        Height="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
  <Border Background="{StaticResource PanelBackground}"
          BorderBrush="#22000000"
          BorderThickness="1"
          CornerRadius="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <TextBlock x:Name="WindowTitle"
                   Margin="20,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#555555" />
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                Padding="9,2"
                MinHeight="25"
                Content="×"
                FontSize="18"
                Click="CloseButton_OnClick" />
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="500" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="22,4,10,18">
          <StackPanel>
            <TextBlock x:Name="ModeTitle" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" />
            <TextBlock x:Name="ModeSubtitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,12" />

            <WrapPanel Margin="0,0,0,5">
              <TextBlock x:Name="WorkLabel" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,16,0" />
              <TextBlock x:Name="BreakLabel" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,16,0" />
              <TextBlock x:Name="AiLabel" FontFamily="Consolas" FontWeight="SemiBold" />
            </WrapPanel>
            <TextBlock x:Name="IdleLabel" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas" />
            <TextBlock x:Name="TodayLabel" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="TotalLabel" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12" />

            <Border Height="1" Background="#18000000" Margin="0,0,0,11" />
            <TextBlock Text="输入仪表" FontSize="17" FontWeight="Bold" />
            <WrapPanel Margin="0,6,0,0">
              <TextBlock x:Name="TypingLabel" Width="150" />
              <TextBlock x:Name="RawSpeedLabel" Width="150" />
              <TextBlock x:Name="CorrectionLabel" Width="150" />
              <TextBlock x:Name="AverageSpeedLabel" Width="150" />
              <TextBlock x:Name="ApmLabel" Width="150" FontWeight="SemiBold" />
              <TextBlock x:Name="EpmLabel" Width="150" FontWeight="SemiBold" />
            </WrapPanel>
            <TextBlock x:Name="InputStatusLabel" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12" />

            <Border Height="1" Background="#18000000" Margin="0,0,0,11" />
            <TextBlock Text="定时提醒" FontSize="17" FontWeight="Bold" />
            <StackPanel x:Name="ReminderRows" Margin="0,5,0,9" />

            <Border Height="1" Background="#18000000" Margin="0,0,0,11" />
            <CheckBox x:Name="AiReminderCheck" Content="Codex 完成提醒" Checked="OptionCheck_OnChanged" Unchecked="OptionCheck_OnChanged" />
            <CheckBox x:Name="SurfaceCheck" Content="显示常驻角色" Checked="OptionCheck_OnChanged" Unchecked="OptionCheck_OnChanged" />
            <CheckBox x:Name="StartupCheck" Content="登录 Windows 时启动" Checked="StartupCheck_OnChanged" Unchecked="StartupCheck_OnChanged" />
            <TextBlock x:Name="CodexStatusLabel" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6" />

            <WrapPanel Margin="0,2,0,5">
              <TextBlock x:Name="ScaleLabel" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Content="重置角色大小" Click="ResetScale_OnClick" />
            </WrapPanel>

            <WrapPanel>
              <Button Content="休息 5 分钟" Click="StartBreak_OnClick" />
              <Button Content="结束休息" Click="EndBreak_OnClick" />
              <Button Content="暂停／继续" Click="TogglePause_OnClick" />
              <Button Content="喝水打卡" Click="Water_OnClick" />
            </WrapPanel>
            <WrapPanel>
              <Button Content="清零今日" Click="ResetToday_OnClick" />
              <Button Content="清空全部" Click="ResetAll_OnClick" />
              <Button Content="打开记录" Click="OpenRecords_OnClick" />
              <Button Content="退出" Click="Quit_OnClick" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ArtContainer" Grid.Column="1" ClipToBounds="True">
          <Image x:Name="PanelImage"
                 Stretch="Uniform"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
