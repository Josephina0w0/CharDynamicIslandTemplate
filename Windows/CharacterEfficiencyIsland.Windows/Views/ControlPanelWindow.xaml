<Window x:Class="CharacterEfficiencyIsland.Windows.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="500"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
  <Border Background="{StaticResource PanelBackground}"
          BorderBrush="Transparent"
          BorderThickness="0"
          CornerRadius="24">
    <Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="18,16,6,14">
          <StackPanel>
            <TextBlock x:Name="ModeTitle" Visibility="Collapsed" />
            <TextBlock x:Name="ModeSubtitle" Visibility="Collapsed" />
            <Border Height="1" Background="#18000000" Margin="0,2,0,7" />

            <WrapPanel Margin="0,0,0,4">
              <TextBlock x:Name="WorkLabel" FontSize="14" FontWeight="Bold" Margin="0,0,11,0" />
              <TextBlock x:Name="BreakLabel" FontSize="14" FontWeight="Bold" Margin="0,0,11,0" />
              <TextBlock x:Name="AiLabel" FontSize="14" FontWeight="Bold" />
            </WrapPanel>
            <WrapPanel>
              <TextBlock x:Name="IdleLabel" Foreground="{StaticResource SecondaryText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="喝水打卡" Click="Water_OnClick" />
            </WrapPanel>
            <TextBlock x:Name="TodayLabel" Foreground="#999999" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" />
            <TextBlock x:Name="TotalLabel" Foreground="#A6A6A6" FontSize="10.5" TextWrapping="Wrap" Margin="0,1,0,8" />

            <Border Height="1" Background="#18000000" Margin="0,0,0,7" />
            <TextBlock Text="定时提醒" FontSize="13.5" FontWeight="Bold" />
            <StackPanel x:Name="ReminderRows" Margin="0,3,0,6" />

            <Border Height="1" Background="#18000000" Margin="0,0,0,7" />
            <CheckBox x:Name="AiReminderCheck" Content="Codex 完成提醒" Checked="OptionCheck_OnChanged" Unchecked="OptionCheck_OnChanged" />
            <CheckBox x:Name="SurfaceCheck" Content="显示常驻角色" Checked="OptionCheck_OnChanged" Unchecked="OptionCheck_OnChanged" />
            <CheckBox x:Name="StartupCheck" Content="登录 Windows 时启动" Checked="StartupCheck_OnChanged" Unchecked="StartupCheck_OnChanged" />
            <TextBlock x:Name="CodexStatusLabel" Foreground="{StaticResource SecondaryText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,1,0,4" />

            <WrapPanel Margin="0,1,0,3">
              <TextBlock x:Name="ScaleLabel" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Content="重置灵动岛大小" Click="ResetScale_OnClick" />
            </WrapPanel>

            <WrapPanel>
              <Button Content="休息 5 分钟" Click="StartBreak_OnClick" />
              <Button Content="结束休息" Click="EndBreak_OnClick" />
              <Button Content="暂停／继续" Click="TogglePause_OnClick" />
            </WrapPanel>
            <WrapPanel>
              <Button Content="清零今日" Click="ResetToday_OnClick" />
              <Button Content="清空全部" Click="ResetAll_OnClick" />
              <Button Content="打开记录" Click="OpenRecords_OnClick" />
              <Button Content="退出" Click="Quit_OnClick" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ArtContainer" Grid.Column="1" ClipToBounds="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.RowSpan="2" Width="1" Background="#10000000" HorizontalAlignment="Left" Margin="0,6,0,12" />
          <StackPanel Grid.Row="0" Margin="14,18,8,6">
            <TextBlock Text="输入仪表" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5" />
            <TextBlock x:Name="TypingLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
            <TextBlock x:Name="RawSpeedLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
            <TextBlock x:Name="CorrectionLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
            <TextBlock x:Name="AverageSpeedLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
            <TextBlock x:Name="ApmLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
            <TextBlock x:Name="EpmLabel" FontSize="12" FontWeight="Bold" Margin="0,1.5" />
            <TextBlock x:Name="InputStatusLabel" Foreground="{StaticResource SecondaryText}" FontSize="9.5" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
          <Image x:Name="PanelImage"
                 Grid.Row="1"
                 Stretch="Uniform"
                 MaxWidth="190"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
